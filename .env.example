LEDGER_SERVICE_URL=http://localhost:8080
PORT=8081

# MVP has no auth: requests without an explicit user_id are attributed to
# this fixed dev user. Must be a lowercase UUID (ledger-service requirement).
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_CURRENCY=usd

# AUTH_DISABLED=true skips Authentik token verification entirely and
# attributes every request to DEFAULT_USER_ID above — local dev /
# single-user self-hosting only. GET /config's auth_enabled (which the
# frontend's FRONT-04 login guard reads) is just the inverse of this, so
# the frontend guard and the API's own enforcement always agree. Leave
# true for local dev without a running Authentik instance; a real
# deployment sets this to false (or unsets it) and configures the
# OIDC_* vars below instead.
AUTH_DISABLED=true
# BACK-20: which services.IdentityVerifier cmd/api constructs when
# AUTH_DISABLED is not true — "authentik" (default) or "simple" (any
# other provider speaking the same OIDC-like iss/sub/exp/aud + JWKS
# contract, e.g. a future standalone username/password auth service).
# AUTH_PROVIDER=authentik

# --- AUTH_PROVIDER=authentik config ---
# Required when AUTH_DISABLED is not true and AUTH_PROVIDER=authentik.
# Authentik's application issuer URL, e.g.
# https://auth.example.com/application/o/financial-tracker/.
# OIDC_ISSUER_URL=
# Optional override that skips OIDC discovery.
# OIDC_JWKS_URL=
# Defaults to PUBLIC_OIDC_CLIENT_ID below (Authentik sets a token's aud to
# the requesting client_id). Set explicitly only if that default is wrong.
# OIDC_AUDIENCE=
# Must match web/.env.example's PUBLIC_OIDC_CLIENT_ID for the same app.
# PUBLIC_OIDC_CLIENT_ID=

# --- AUTH_PROVIDER=simple config (independent of the OIDC_* vars above —
# only read when AUTH_PROVIDER=simple) ---
# Required when AUTH_PROVIDER=simple.
# SIMPLE_AUTH_ISSUER_URL=
# Optional override that skips OIDC-style discovery.
# SIMPLE_AUTH_JWKS_URL=
# Optional; unset means the `aud` claim is not checked.
# SIMPLE_AUTH_AUDIENCE=

# Local database - the source of truth for movements. DB_DRIVER selects
# sqlite (default, uses DB_PATH) or postgres (uses DATABASE_URL).
DB_DRIVER=sqlite
DB_PATH=./data/financial-tracker.db
# DATABASE_URL=postgres://user:password@localhost:5432/financial_tracker?sslmode=disable

# Postgres connection pool bounds (only used when DB_DRIVER=postgres).
# Defaults shown below are sized for one API instance; uncomment to tune.
# POSTGRES_MAX_OPEN_CONNS=10
# POSTGRES_MAX_IDLE_CONNS=5
# POSTGRES_CONN_MAX_LIFETIME=30m
# POSTGRES_CONN_MAX_IDLE_TIME=5m

# Background sync to ledger-service (Go duration strings).
SYNC_INTERVAL=30s
SYNC_RETRY_COOLDOWN=60s
