PUBLIC_API_URL=http://localhost:8081

# OIDC (Authentik) — only required when the API's GET /config reports
# auth_enabled: true (see the API's own AUTH_ENABLED in .env.example).
# No client secret: browser-side PKCE only. PUBLIC_OIDC_ISSUER is
# Authentik's application issuer URL (…/application/o/<slug>/);
# PUBLIC_OIDC_CLIENT_ID is that application's client id.
PUBLIC_OIDC_ISSUER=
PUBLIC_OIDC_CLIENT_ID=
