PUBLIC_API_URL=http://localhost:8081

# OIDC (Authentik) — only required when the API's GET /config reports
# auth_enabled: true, i.e. whenever the API isn't running with
# AUTH_DISABLED=true (see the API's own .env.example). No client secret:
# browser-side PKCE only. PUBLIC_OIDC_ISSUER is Authentik's application
# issuer URL (…/application/o/<slug>/); PUBLIC_OIDC_CLIENT_ID is that
# application's client id (must match the API's own PUBLIC_OIDC_CLIENT_ID
# / OIDC_AUDIENCE for the same app).
PUBLIC_OIDC_ISSUER=
PUBLIC_OIDC_CLIENT_ID=
